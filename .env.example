# Получите токен у @BotFather. Никогда не публикуйте настоящий токен.
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# official = стандартный сервер Telegram (скачивание до 20 MB, отправка до 50 MB)
# local = собственный Local Bot API Server (требуется отдельная установка и настройка)
BOT_API_MODE=official
BOT_API_BASE_URL=https://api.telegram.org

# Для обычного Bot API не увеличивайте эти значения выше лимитов Telegram.
MAX_INPUT_MB=19
MAX_OUTPUT_MB=47
MAX_DURATION_SECONDS=600

# Папка временных файлов и SQLite. В Docker это постоянный том ./data.
DATA_DIR=./data
MAX_PARALLEL_JOBS=1
JOB_TIMEOUT_SECONDS=900

# Ограничение пользовательских обработок: 3 задачи за 10 минут на одного пользователя.
USER_RATE_LIMIT_COUNT=3
USER_RATE_LIMIT_WINDOW_SECONDS=600

