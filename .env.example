# Скопируйте этот файл в .env и заполните. Файл .env никогда не загружайте в GitHub.

# === Обязательно ===
# Токен от @BotFather. Никогда не публикуйте настоящий токен.
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# === Большие видео (больше 20 МБ) — бесплатно ===
# api_id и api_hash: https://my.telegram.org → API development tools.
# С ними бот скачивает и отправляет файлы через MTProto (до 2000 МБ) без отдельного сервера.
# Если оставить пустыми — стандартные лимиты Bot API: вход 20 МБ, выход 50 МБ.
TG_API_ID=
TG_API_HASH=

# === Доступ ===
# Твой Telegram ID (бот покажет его по команде /id). Несколько ID — через запятую.
# Пусто = ботом может пользоваться кто угодно (с ограничением частоты ниже).
ALLOWED_USER_IDS=

# official = стандартный сервер Telegram (по умолчанию)
# local = собственный Local Bot API Server (требуется отдельная установка и настройка)
BOT_API_MODE=official
BOT_API_BASE_URL=https://api.telegram.org

# Лимиты в МБ. Пусто = автоматически:
#   без TG_API_ID/TG_API_HASH — вход 19, выход 47 (выше Bot API не позволяет);
#   с TG_API_ID/TG_API_HASH — вход 300, выход 1000 (максимум 2000);
#   BOT_API_MODE=local — вход 500, выход 1800.
MAX_INPUT_MB=
MAX_OUTPUT_MB=
MAX_DURATION_SECONDS=600

# Папка временных файлов, SQLite и сессии MTProto. В Docker это том botdata.
DATA_DIR=./data
MAX_PARALLEL_JOBS=1
JOB_TIMEOUT_SECONDS=900

# Сколько минут хранить загруженный исходник для повторной обработки без новой загрузки.
PENDING_TTL_MINUTES=30
# Максимум копий за один запуск уникализатора (1–10).
MAX_UNIQUE_COPIES=5

# Ограничение частоты для публичного бота: 3 загрузки и 3 обработки за 10 минут на пользователя.
# Если задан ALLOWED_USER_IDS, ограничение не действует.
USER_RATE_LIMIT_COUNT=3
USER_RATE_LIMIT_WINDOW_SECONDS=600
